{
  "name": "monorepo-root",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --hot apps/backend/src/index.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "bun --filter @repo/db db:generate",
    "db:migrate": "bun --filter @repo/db db:migrate",
    "db:deploy": "bun --filter @repo/db db:deploy",
    "db:studio": "bun --filter @repo/db db:studio",
    "db:reset": "bun --filter @repo/db db:reset",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "bun-create": {
    "postinstall": ["bun run scripts/init-template.ts"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": ["@biomejs/biome", "@prisma/client", "@prisma/engines", "prisma"]
}
