{
  "name": "monorepo-root",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --hot apps/backend/src/index.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema=packages/db/prisma/schema.prisma",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck",
    "prepare": "lefthook install || true"
  },
  "bun-create": {
    "postinstall": ["bun run scripts/init-template.ts"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.6",
    "prisma": "^5.20.0",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": ["@biomejs/biome", "@prisma/client", "@prisma/engines", "prisma"]
}
