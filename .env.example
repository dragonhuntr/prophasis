# Database
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Backend HTTP
PORT=3000
LOG_LEVEL="debug"

# better-auth
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of allowed CORS origins. Empty = same-origin only.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001"

# Cloudflare Email Service (used by @repo/email — required for password reset)
CF_ACCOUNT_ID=""
CF_EMAIL_API_TOKEN=""
EMAIL_FROM="no-reply@yourdomain.com"
# Optional: human-readable sender name shown in clients
# EMAIL_FROM_NAME="Your App"

# Cloudflare R2 (only required if importing @repo/r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional: override the default https://<account>.r2.cloudflarestorage.com endpoint
# R2_ENDPOINT=""
